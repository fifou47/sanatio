# Traefik host-based routing (dev): each service has its own hostname.
# For mobile devices/emulators, hostnames like *.viby.to may not resolve.
# You can switch to a gateway base URL + path routing later with EXPO_PUBLIC_GATEWAY_URL.

# Adresse IP du poste de développement pour accéder aux APIs en local
EXPO_PUBLIC_AUTH_URL=http://192.168.1.79:3000
EXPO_PUBLIC_CONSULTATION_URL=http://192.168.1.79:4008
EXPO_PUBLIC_PATIENT_URL=http://192.168.1.79:4000
EXPO_PUBLIC_DOCTOR_URL=http://192.168.1.79:4004
EXPO_PUBLIC_BILLING_URL=http://192.168.1.79:4005
EXPO_PUBLIC_WS_URL=ws://192.168.1.79:4008
EXPO_PUBLIC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
EXPO_PUBLIC_ENABLE_DEBUG=true
# Optional: if you centralize routing under a single host, set this
# EXPO_PUBLIC_GATEWAY_URL=http://api.viby.to
