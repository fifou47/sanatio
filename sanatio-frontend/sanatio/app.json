{
  "expo": {
    "plugins": [
      ["expo-secure-store"]
    ],
    "scheme": "sanatio",
    "name": "sanatio",
    "slug": "sanatio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera for video calls and document capture.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["INTERNET", "CAMERA", "RECORD_AUDIO"],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@livekit/react-native",
        {
          "android": {
            "permissions": [
              "android.permission.CAMERA",
              "android.permission.RECORD_AUDIO"
            ]
          },
          "ios": {
            "cameraPermission": "L'application a besoin d'accéder à votre caméra pour les consultations vidéo.",
            "microphonePermission": "L'application a besoin d'accéder à votre micro pour les consultations vidéo."
          }
        }
      ]
    ]
  }
}
