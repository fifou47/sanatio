# Traefik host-based routing (dev): each service has its own hostname.
# For mobile devices/emulators, hostnames like *.localhost may not resolve.
# You can switch to a gateway base URL + path routing later with EXPO_PUBLIC_GATEWAY_URL.

EXPO_PUBLIC_AUTH_URL=http://auth.localhost
EXPO_PUBLIC_CONSULT_URL=http://consult.localhost
EXPO_PUBLIC_PATIENT_URL=http://patient.localhost
EXPO_PUBLIC_DOCTOR_URL=http://doctor.localhost
EXPO_PUBLIC_BILLING_URL=http://billing.localhost
EXPO_PUBLIC_WS_URL=ws://consult.localhost
EXPO_PUBLIC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
EXPO_PUBLIC_ENABLE_DEBUG=true
# Optional: if you centralize routing under a single host, set this
# EXPO_PUBLIC_GATEWAY_URL=http://api.localhost
